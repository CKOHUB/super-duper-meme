local HAS_DRAWING = Drawing and Drawing.new
local function getParent()
    local ok, ui = pcall(function() return gethui() end)
    if ok and ui then return ui end
    return CoreGui
end

local Holder = Instance.new("Folder")
Holder.Name = "CKOHUBX2_Holder"
Holder.Parent = getParent()

local ESPCache = {}
local FOVCircle
if HAS_DRAWING then
    FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 1
    FOVCircle.NumSides = 64
    FOVCircle.Filled = false
    FOVCircle.Color = Color3.fromRGB(255, 255, 255)
    FOVCircle.Visible = false
end

local function removeESP(plr)
    local e = ESPCache[plr]
    if not e then return end
    pcall(function()
        if e.HL then e.HL:Destroy() end
        if e.Box then e.Box:Remove() end
        if e.Name then e.Name:Remove() end
    end)
    ESPCache[plr] = nil
    marcaAliadoCache[plr] = nil
end

local function updateESP(plr)
    if not espEnabled or not isEnemy(plr) then
        local e = ESPCache[plr]
        if e and e.HL then e.HL.Enabled = false end
        if e and e.Box then e.Box.Visible = false end
        if e and e.Name then e.Name.Visible = false end
        return
    end
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not hrp or hum.Health <= 0 then return end

    local e = ESPCache[plr]
    if not e then
        e = {}
        if HAS_DRAWING then
            e.Box = Drawing.new("Square")
            e.Box.Thickness = 1
            e.Box.Filled = false
            e.Name = Drawing.new("Text")
            e.Name.Size = 14
            e.Name.Center = true
            e.Name.Outline = true
        end
        ESPCache[plr] = e
    end

    if espGlow then
        if not e.HL or not e.HL.Parent then
            e.HL = Instance.new("Highlight")
            e.HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            e.HL.FillTransparency = 0.5
            e.HL.Parent = Holder
        end
        e.HL.Adornee = char
        e.HL.Enabled = true
        e.HL.FillColor = espColor
        e.HL.OutlineColor = espColor
    elseif e.HL then
        e.HL.Enabled = false
    end

    if HAS_DRAWING and e.Box then
        local cam = Workspace.CurrentCamera
        local pos, on = cam:WorldToViewportPoint(hrp.Position)
        if on then
            local top = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.8, 0))
            local bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.2, 0))
            local h = math.abs(bot.Y - top.Y)
            local w = h * 0.6
            e.Box.Size = Vector2.new(w, h)
            e.Box.Position = Vector2.new(pos.X - w / 2, top.Y)
            e.Box.Color = espColor
            e.Box.Visible = true
            if e.Name then
                e.Name.Text = plr.DisplayName
                e.Name.Position = Vector2.new(pos.X, top.Y - 18)
                e.Name.Color = espColor
                e.Name.Visible = true
            end
        else
            e.Box.Visible = false
            if e.Name then e.Name.Visible = false end
        end
    end
end

Players.PlayerRemoving:Connect(removeESP)

