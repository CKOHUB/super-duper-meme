-- COMBAT LOOPS
-------------------------------------------------

task.spawn(function()
    while task.wait(0.1) do
        if Unloaded then break end
        if not autoShootEnabled and not autoShootAgresivoEnabled then
            if not silentAimManualEnabled and not silentAimFovEnabled then
                getgenv().CKOHUBX2Target = nil
            end
            continue
        end
        local char = player.Character
        if not char then continue end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool or not esPistola(tool) then continue end

        local target = GetTarget(autoShootAgresivoEnabled, silentAimFovEnabled)
        if target then
            getgenv().CKOHUBX2Target = target
            pcall(function()
                tool:Activate()
                task.delay(0.05, function()
                    if tool.Parent == char then pcall(function() tool:Deactivate() end) end
                end)
            end)
        else
            getgenv().CKOHUBX2Target = nil
        end
    end
end)

task.spawn(function()
    while task.wait(0.05) do
        if Unloaded then break end
        if silentAimManualEnabled or silentAimFovEnabled then
            local t = GetTarget(false, silentAimFovEnabled)
            getgenv().CKOHUBX2Target = t
        elseif not autoShootEnabled and not autoShootAgresivoEnabled then
            getgenv().CKOHUBX2Target = nil
        end
    end
end)

task.spawn(function()
    while task.wait(0.15) do
        if Unloaded or not KillAllEnabled then continue end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end

        local closest, closestDist = nil, KillAllRadius
        for _, plr in ipairs(Players:GetPlayers()) do
            if isEnemy(plr) then
                local ec = plr.Character
                local eHum = ec and ec:FindFirstChildOfClass("Humanoid")
                local eHRP = ec and ec:FindFirstChild("HumanoidRootPart")
                if eHum and eHRP and eHum.Health > 0 then
                    local d = (eHRP.Position - hrp.Position).Magnitude
                    if d < closestDist then
                        closest = eHRP
                        closestDist = d
                    end
                end
            end
        end
        if closest then
            local j = Vector3.new((math.random() - 0.5) * KillAllJitter, 0, (math.random() - 0.5) * KillAllJitter)
            pcall(function() hrp.CFrame = CFrame.new(closest.Position + Vector3.new(0, 0, 2) + j) end)
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function()
                    tool:Activate()
                    task.delay(0.05, function()
                        if tool.Parent == char then pcall(function() tool:Deactivate() end) end
                    end)
                end)
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if Unloaded then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then updateESP(plr) end
    end
    if FOVCircle then
        FOVCircle.Visible = fovVisiblePreference
        if FOVCircle.Visible then
            FOVCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            FOVCircle.Radius = fovRadius
            FOVCircle.Color = getgenv().CKOHUBX2Target and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
        end
    end
end)

