-------------------------------------------------
-- TEAM CHECK (KEVEN: verde + TeamColor + Attribute)
-------------------------------------------------

local COLORES_NEUTROS = {
    ["White"] = true, ["Medium stone grey"] = true, ["Medium Stone Grey"] = true,
    ["Really black"] = true, ["Really Black"] = true,
    ["Institutional white"] = true, ["Institutional White"] = true,
    ["Ghost grey"] = true, ["Ghost Grey"] = true,
}

local ATTRS_ALIADO = {
    "IsAlly","Ally","AllyMarker","isAlly","is_ally","ally",
    "Teammate","isTeammate","is_teammate","IsTeammate",
    "Friendly","isFriendly","IsFriendly","is_friendly"
}

local marcaAliadoCache = {}

local function esColorVerde(c)
    if typeof(c) ~= "Color3" then return false end
    return c.G >= 0.55 and c.G > c.R and c.G > c.B and (c.G - c.R) >= 0.15 and (c.G - c.B) >= 0.15
end

local function guiTieneVerde(obj)
    if not obj then return false end
    local ok1, bg = pcall(function() return obj.BackgroundColor3 end)
    if ok1 and bg and esColorVerde(bg) then return true end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        local ok2, tc = pcall(function() return obj.TextColor3 end)
        if ok2 and tc and esColorVerde(tc) then return true end
    end
    return false
end

local function contenedorTieneVerde(container)
    if not container then return false end
    for _, desc in ipairs(container:GetDescendants()) do
        if desc:IsA("GuiObject") and guiTieneVerde(desc) then return true end
        if desc:IsA("Highlight") and (esColorVerde(desc.FillColor) or esColorVerde(desc.OutlineColor)) then return true end
    end
    return false
end

local function tieneMarcaAliado(targetPlayer)
    if not targetPlayer then return false end
    local now = os.clock()
    local cached = marcaAliadoCache[targetPlayer]
    if cached and (now - cached.time) < 1 then return cached.value end

    local resultado = false
    local char = targetPlayer.Character

    for _, attrName in ipairs(ATTRS_ALIADO) do
        local v1 = targetPlayer:GetAttribute(attrName)
        if v1 == true or v1 == "true" or v1 == "Ally" or v1 == "ally" then resultado = true break end
        if char then
            local v2 = char:GetAttribute(attrName)
            if v2 == true or v2 == "true" or v2 == "Ally" or v2 == "ally" then resultado = true break end
        end
    end

    if not resultado then
        local myAttr = player:GetAttribute("Team") or player:GetAttribute("team")
        local otherAttr = targetPlayer:GetAttribute("Team") or targetPlayer:GetAttribute("team")
        if myAttr and otherAttr and myAttr ~= "" and otherAttr ~= "" and myAttr == otherAttr then
            resultado = true
        end
    end

    if not resultado and char then
        for _, partName in ipairs({"Head", "HumanoidRootPart"}) do
            local part = char:FindFirstChild(partName)
            if part then
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("BillboardGui") and contenedorTieneVerde(child) then resultado = true break end
                    if child:IsA("Highlight") and (esColorVerde(child.FillColor) or esColorVerde(child.OutlineColor)) then resultado = true break end
                    if child:IsA("Attachment") and contenedorTieneVerde(child) then resultado = true break end
                end
            end
            if resultado then break end
        end
        if not resultado then
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Highlight") and (esColorVerde(child.FillColor) or esColorVerde(child.OutlineColor)) then
                    resultado = true break
                end
            end
        end
    end

    marcaAliadoCache[targetPlayer] = { value = resultado, time = now }
    return resultado
end

local function isEnemy(targetPlayer)
    if not targetPlayer or targetPlayer == player then return false end
    if tieneMarcaAliado(targetPlayer) then return false end
    if not teamCheckEnabled then return true end

    local myColorName = player.TeamColor and player.TeamColor.Name or "White"
    local otherColorName = targetPlayer.TeamColor and targetPlayer.TeamColor.Name or "White"
    if not COLORES_NEUTROS[myColorName] and not COLORES_NEUTROS[otherColorName] then
        return player.TeamColor ~= targetPlayer.TeamColor
    end

    if player.Team and targetPlayer.Team then
        return player.Team ~= targetPlayer.Team
    end

    local myAttr = player:GetAttribute("Team") or player:GetAttribute("team")
    local otherAttr = targetPlayer:GetAttribute("Team") or targetPlayer:GetAttribute("team")
    if myAttr and otherAttr and myAttr ~= "" and otherAttr ~= "" then
        return myAttr ~= otherAttr
    end

    return true
end

local function esPistola(item)
    if not item or not item:IsA("Tool") then return false end
    local n = item.Name:lower()
    if n:find("knife") or n:find("cuchillo") or n:find("sword") or n:find("fist") then return false end
    if item:FindFirstChild("Slash") or item:FindFirstChild("Throw", true) then return false end
    return true
end

-------------------------------------------------
-- SILENT HOOK
-------------------------------------------------

pcall(function()
    if not (hookmetamethod and newcclosure and checkcaller and getnamecallmethod) then return end
    local old
    old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local target = getgenv().CKOHUBX2Target
        if not checkcaller() and target and target.Parent and self == Workspace and method == "Raycast" then
            local origin, direction, p3 = ...
            if typeof(direction) == "Vector3" and direction.Magnitude > 15 then
                local camOrigin = camera.CFrame.Position
                if (origin - camOrigin).Magnitude >= 1 then
                    return old(self, origin, (target.Position - origin).Unit * 5000, p3)
                end
            end
        end
        return old(self, ...)
    end))
end)

-------------------------------------------------
-- TARGET
-------------------------------------------------

local function GetTarget(agresivo, useFov)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, bestDist = nil, (useFov and fovRadius) or 9999
    local myChar = player.Character
    local headPos = myChar and myChar:FindFirstChild("Head") and myChar.Head.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not char:FindFirstChildOfClass("ForceField") then
                params.FilterDescendantsInstances = { myChar, char }
                local parts = {}
                if agresivo then
                    for _, p in ipairs(char:GetChildren()) do
                        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then table.insert(parts, p) end
                    end
                else
                    if silentAimTargetPart == "Cabeza" or silentAimTargetPart == "Head" then
                        local h = char:FindFirstChild("Head")
                        if h then table.insert(parts, h) end
                    elseif silentAimTargetPart == "Torso" then
                        for _, n in ipairs({"UpperTorso", "Torso", "HumanoidRootPart"}) do
                            local p = char:FindFirstChild(n)
                            if p then table.insert(parts, p) end
                        end
                    else
                        for _, p in ipairs(char:GetChildren()) do
                            if p:IsA("BasePart") then table.insert(parts, p) end
                        end
                    end
                end
                for _, part in ipairs(parts) do
                    local sp, on = cam:WorldToViewportPoint(part.Position)
                    if on and sp.Z > 0 then
                        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if dist < bestDist then
                            if not headPos or not Workspace:Raycast(headPos, part.Position - headPos, params) then
                                best = part
                                bestDist = dist
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

